# ===========================================
# REQUIRED — the agent will not start without these
# ===========================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
GITHUB_TOKEN=your_github_token_here

# ===========================================
# Single-model fallback (used only if a task's chain below is left empty)
# ===========================================
OPENROUTER_CODING_MODEL=openai/gpt-4o-mini
OPENROUTER_REVIEW_MODEL=openai/gpt-4o-mini
OPENROUTER_ANALYSIS_MODEL=openai/gpt-4o-mini

# ===========================================
# Per-task model fallback chains (comma-separated, tried in order)
# Verify current model IDs at https://openrouter.ai/models before changing —
# provider model names change/deprecate over time.
# ===========================================
MODELS_PLANNING=openai/gpt-4o-mini,anthropic/claude-haiku-4.5,anthropic/claude-sonnet-5,openai/gpt-5.1
MODELS_CODING=qwen/qwen3-coder:free,openai/gpt-4o-mini,anthropic/claude-sonnet-5,deepseek/deepseek-r1:free
MODELS_REVIEW=openai/gpt-4o-mini,anthropic/claude-haiku-4.5,openai/gpt-5.1
MODELS_DEBUG=deepseek/deepseek-r1:free,qwen/qwen3-coder:free,openai/gpt-4o-mini
MODELS_ANALYSIS=openai/gpt-4

# ===========================================
# Dynamic model fallback — OFF by default (see README for details)
# Only activates if an entire static chain above fails for a task.
# Queries OpenRouter's live catalog, capped by price, never auto-escalates
# beyond MAX_DYNAMIC_MODEL_PRICE_PER_MILLION.
# ===========================================
ENABLE_DYNAMIC_MODEL_FALLBACK=false
MAX_DYNAMIC_MODEL_PRICE_PER_MILLION=2.0
DYNAMIC_MODEL_CACHE_TTL_SECONDS=600

# ===========================================
# Safety — ALWAYS keep this false unless you fully understand the risk.
# When true, shell commands run without asking for your confirmation first.
# ===========================================
AUTO_APPROVE_COMMANDS=false

# ===========================================
# Pipeline behavior
# ===========================================
MAX_DEBUG_RETRIES=3
REPO_SELECTION_POOL_SIZE=5
WORKSPACE_DIR=./workspace
LOGS_DIR=./logs

# ===========================================
# Optional cosmetic terminal companion — purely visual, no effect on
# agent logic. Off by default; only renders when stdout is a real terminal.
# ===========================================
ENABLE_SPRITE_UI=false
